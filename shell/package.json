{
  "name": "weft-shell",
  "version": "0.1.2",
  "private": true,
  "license": "MPL-2.0",
  "description": "Weft's shell and model: the React interface and the pure TypeScript the Chromium fork builds into chrome://weft.",
  "scripts": {
    "dev": "vite --config dev/vite.config.mjs",
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p ../chromium/shell --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build --config ../chromium/shell/vite.config.mjs --outDir \"$PWD/out/shell\" --logLevel warn",
    "dev:smoke": "node dev/smoke.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.59.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
