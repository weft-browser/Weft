+// Unpacked extensions: every folder under <data dir>/extensions with a
+// manifest.json, sorted (store.ts listExtensions).
+std::vector<std::string> ListExtensionsTask(base::FilePath path) {
+  std::vector<std::string> names;
+  base::FileEnumerator it(path, false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath f = it.Next(); !f.empty(); f = it.Next()) {
+    if (base::PathExists(f.Append("manifest.json"))) {
+      names.push_back(f.BaseName().value());
+    }
+  }
+  std::sort(names.begin(), names.end());
+  return names;
+}
