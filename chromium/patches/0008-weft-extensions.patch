+void WeftUI::ApplyExtensions(const std::string& ws_id) {
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+  auto it = workspaces_.find(ws_id);
+  if (it == workspaces_.end() || !it->second->profile || !it->second->env) {
+    return;
+  }
+  Workspace& ws = *it->second;
+  // An off-the-record profile takes its extensions from the regular one it
+  // hangs off, which every disposable workspace shares: none there.
+  if (ws.profile->IsOffTheRecord()) {
+    return;
+  }
+  const base::DictValue* ext = ws.env->FindDict("ext");
+  if (!ext) {
+    return;
+  }
+  // A profile made moments ago is still bringing its extension system up;
+  // loading into it before then trips the registry.
+  auto* system = extensions::ExtensionSystem::Get(ws.profile);
+  if (!system->is_ready()) {
+    system->ready().Post(FROM_HERE,
+                         base::BindOnce(&WeftUI::ApplyExtensions,
+                                        weak_factory_.GetWeakPtr(), ws_id));
+    return;
+  }
+  auto* registrar = extensions::ExtensionRegistrar::Get(ws.profile);
+  auto* registry = extensions::ExtensionRegistry::Get(ws.profile);
+  for (const auto [name, on] : *ext) {
+    const bool wanted = on.GetIfBool().value_or(false);
+    auto loaded = ws.ext_ids.find(name);
+    if (loaded != ws.ext_ids.end()) {
+      const std::string& id = loaded->second;
+      if (wanted && registry->disabled_extensions().Contains(id)) {
+        registrar->EnableExtension(id);
+      } else if (!wanted && registry->enabled_extensions().Contains(id)) {
+        registrar->DisableExtension(
+            id, {extensions::disable_reason::DISABLE_USER_ACTION});
+      }
+      continue;
+    }
+    if (!wanted || ws.ext_loading.count(name) ||
+        name.find('/') != std::string::npos || name == "..") {
+      continue;
+    }
+    ws.ext_loading.insert(name);
+    auto installer = extensions::UnpackedInstaller::Create(ws.profile);
+    installer->set_be_noisy_on_failure(false);
+    installer->set_completion_callback(base::BindOnce(
+        [](base::WeakPtr<WeftUI> ui, const std::string& ws_id,
+           const std::string& name, const extensions::Extension* extension,
+           const base::FilePath&, const std::u16string& error) {
+          if (ui) {
+            ui->OnExtensionLoaded(ws_id, name,
+                                  extension ? extension->id() : std::string(),
+                                  base::UTF16ToUTF8(error));
+          }
+        },
+        weak_factory_.GetWeakPtr(), ws_id, name));
+    installer->Load(DataDir().Append("extensions").Append(name));
+  }
+#endif
+}
+
+void WeftUI::OnExtensionLoaded(const std::string& ws_id,
+                               const std::string& name,
+                               const std::string& id,
+                               const std::string& error) {
+  auto it = workspaces_.find(ws_id);
+  if (it == workspaces_.end()) {
+    return;
+  }
+  Workspace& ws = *it->second;
+  ws.ext_loading.erase(name);
+  if (id.empty()) {
+    base::DictValue e;
+    e.Set("type", "warn");
+    e.Set("text", "Could not load \"" + name + "\": " +
+                      (error.empty() ? "not an extension" : error));
+    Emit(std::move(e));
+    return;
+  }
+  ws.ext_ids[name] = id;
+  // The switch may have moved while it loaded; settle it once the installer's
+  // own stack has unwound (the registry is mid-update when this runs).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WeftUI::ApplyExtensions,
+                                weak_factory_.GetWeakPtr(), ws_id));
+}
