new file mode 100644
index 0000000000..b7f48dc900
--- /dev/null
+++ b/chrome/browser/weft/tracker_throttle.cc
@@ -0,0 +1,226 @@
+// Copyright 2026 Walnut Labs LLC
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/weft/tracker_throttle.h"
+
+#include <utility>
+#include <vector>
+
+#include <map>
+
+#include "base/memory/ptr_util.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "url/gurl.h"
+
+namespace weft {
+
+namespace {
+
+std::set<std::string>& Trackers() {
+  static base::NoDestructor<std::set<std::string>> hosts;
+  return *hosts;
+}
+
+std::set<std::string>& Allow() {
+  static base::NoDestructor<std::set<std::string>> keys;
+  return *keys;
+}
+
+std::map<content::WebContents*, PageRef>& Pages() {
+  static base::NoDestructor<std::map<content::WebContents*, PageRef>> pages;
+  return *pages;
+}
+
+}  // namespace
+
+void RegisterPage(content::WebContents* contents, PageRef ref) {
+  Pages()[contents] = std::move(ref);
+}
+
+void UnregisterPage(content::WebContents* contents) {
+  Pages().erase(contents);
+}
+
+const PageRef* PageOf(content::WebContents* contents) {
+  auto it = Pages().find(contents);
+  return it == Pages().end() ? nullptr : &it->second;
+}
+
+// static
+void TrackerThrottle::SetTrackers(std::set<std::string> hosts) {
+  Trackers() = std::move(hosts);
+}
+
+// static
+void TrackerThrottle::SetAllow(std::set<std::string> keys) {
+  Allow() = std::move(keys);
+}
+
+// static
+bool TrackerThrottle::IsTracker(const std::string& host) {
+  const std::vector<std::string> parts = base::SplitString(
+      base::ToLowerASCII(host), ".", base::KEEP_WHITESPACE,
+      base::SPLIT_WANT_ALL);
+  for (size_t i = 0; i + 1 < parts.size(); ++i) {
+    if (Trackers().count(base::JoinString(
+            std::vector<std::string>(parts.begin() + i, parts.end()), "."))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// static
+std::string TrackerThrottle::SiteOf(const std::string& host) {
+  static const base::NoDestructor<std::set<std::string>> kSecondLevel(
+      {"co", "com", "org", "net", "gov", "ac", "edu"});
+  const std::vector<std::string> parts = base::SplitString(
+      base::ToLowerASCII(host), ".", base::KEEP_WHITESPACE,
+      base::SPLIT_WANT_ALL);
+  if (parts.size() <= 2) {
+    return base::JoinString(parts, ".");
+  }
+  const size_t n = kSecondLevel->count(parts[parts.size() - 2]) &&
+                           parts.back().size() == 2
+                       ? 3
+                       : 2;
+  return base::JoinString(
+      std::vector<std::string>(parts.end() - n, parts.end()), ".");
+}
+
+// static
+bool TrackerThrottle::IsThirdParty(const std::string& request_host,
+                                   const std::string& top_host) {
+  return !top_host.empty() && SiteOf(request_host) != SiteOf(top_host);
+}
+
+// static
+std::unique_ptr<blink::URLLoaderThrottle> TrackerThrottle::MaybeCreate(
+    const network::ResourceRequest& request,
+    const base::RepeatingCallback<content::WebContents*()>& wc_getter) {
+  if (request.is_outermost_main_frame || !wc_getter ||
+      !request.url.SchemeIsHTTPOrHTTPS()) {
+    return nullptr;
+  }
+  content::WebContents* contents = wc_getter.Run();
+  if (!contents || !PageOf(contents)) {
+    return nullptr;
+  }
+  return base::WrapUnique(new TrackerThrottle(wc_getter));
+}
+
+TrackerThrottle::TrackerThrottle(
+    base::RepeatingCallback<content::WebContents*()> wc_getter)
+    : wc_getter_(std::move(wc_getter)) {}
+
+TrackerThrottle::~TrackerThrottle() = default;
+
+// static
+bool TrackerThrottle::ShouldBlock(content::WebContents* contents,
+                                  const GURL& url) {
+  const PageRef* page = contents ? PageOf(contents) : nullptr;
+  if (!page || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  const GURL& top_url = contents->GetLastCommittedURL();
+  const std::string top(top_url.host());
+  const std::string host(url.host());
+  // The shell's allow keys are "<wsId>|<host>" with the port when there is
+  // one (hostOf() in model.ts).
+  const std::string top_key =
+      top + (top_url.has_port() ? ":" + std::string(top_url.port()) : "");
+  if (!IsThirdParty(host, top) || !IsTracker(host) ||
+      Allow().count(page->ws_id + "|" + top_key)) {
+    return false;
+  }
+  page->on_blocked.Run();
+  return true;
+}
+
+bool TrackerThrottle::MaybeBlock(const GURL& url) {
+  if (!ShouldBlock(wc_getter_.Run(), url)) {
+    return false;
+  }
+  delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, "weft tracker");
+  return true;
+}
+
+void TrackerThrottle::WillStartRequest(network::ResourceRequest* request,
+                                       bool* defer) {
+  MaybeBlock(request->url);
+}
+
+void TrackerThrottle::WillRedirectRequest(
+    net::RedirectInfo* redirect_info,
+    const network::mojom::URLResponseHead& response_head,
+    bool* defer,
+    network::HttpRequestHeadersUpdateParams* headers_update_params) {
+  MaybeBlock(redirect_info->new_url);
+}
+
+const char* TrackerThrottle::NameForLoggingWillStartRequest() {
+  return "WeftTrackerThrottle";
+}
+
+TrackerFactory::TrackerFactory(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> loader_receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+    base::WeakPtr<content::WebContents> contents,
+    base::SelfDeletingPassKey pass_key)
+    : network::SelfDeletingURLLoaderFactory(std::move(loader_receiver),
+                                            pass_key),
+      contents_(std::move(contents)) {
+  target_factory_.Bind(std::move(target_factory));
+  target_factory_.set_disconnect_handler(base::BindOnce(
+      &TrackerFactory::OnTargetFactoryError, base::Unretained(this)));
+}
+
+TrackerFactory::~TrackerFactory() = default;
+
+// static
+void TrackerFactory::MaybeProxyRequest(
+    content::RenderFrameHost* frame,
+    network::URLLoaderFactoryBuilder& builder) {
+  content::WebContents* contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (!contents || !PageOf(contents)) {
+    return;
+  }
+  auto [receiver, remote] = builder.Append();
+  base::MakeSelfDeleting<TrackerFactory>(std::move(receiver), std::move(remote),
+                                         contents->GetWeakPtr());
+}
+
+void TrackerFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  if (TrackerThrottle::ShouldBlock(contents_.get(), request.url)) {
+    mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+        ->OnComplete(
+            network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+    return;
+  }
+  target_factory_->CreateLoaderAndStart(std::move(loader_receiver), request_id,
+                                        options, request, std::move(client),
+                                        traffic_annotation);
+}
+
+void TrackerFactory::OnTargetFactoryError() {
+  DisconnectReceiversAndDestroy();
+}
+
+}  // namespace weft
