@@ -0,0 +1,139 @@
+// Copyright 2026 Walnut Labs LLC
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_WEFT_TRACKER_THROTTLE_H_
+#define CHROME_BROWSER_WEFT_TRACKER_THROTTLE_H_
+
+#include <memory>
+#include <set>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/types/pass_key.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/network/public/cpp/self_deleting_url_loader_factory.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+
+class GURL;
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+namespace network {
+struct ResourceRequest;
+}  // namespace network
+
+namespace weft {
+
+// The page a WebContents is, for the parts of the browser that meet pages
+// without going through the shell. Registered by WeftUI for each page.
+struct PageRef {
+  std::string id;
+  std::string ws_id;
+  base::RepeatingClosure on_blocked;
+};
+void RegisterPage(content::WebContents* contents, PageRef ref);
+void UnregisterPage(content::WebContents* contents);
+const PageRef* PageOf(content::WebContents* contents);
+
+// Weft's tracker blocking, the fork's half of weft-browser-app's
+// src/main/sessions.ts onBeforeRequest hook: a third-party request from a
+// page to a host on the tracker list is cancelled, unless the site has
+// tracker blocking switched off in that workspace. The list and the allow
+// set come from the shell (weft_ui.cc, setTrackers / setAllow). Two
+// entry points, because Chromium decides requests in two places: this
+// throttle sees navigations (frames), TrackerFactory below sees a document's
+// subresources.
+class TrackerThrottle : public blink::URLLoaderThrottle {
+ public:
+  // The shell's lists, process-wide.
+  static void SetTrackers(std::set<std::string> hosts);
+  static void SetAllow(std::set<std::string> keys);  // "<wsId>|<topHost>"
+
+  // Whether a request to `url` from the page `contents` is a blocked
+  // tracker; counts it for the shell when it is.
+  static bool ShouldBlock(content::WebContents* contents, const GURL& url);
+
+  // The app's rules (trackers.ts): a host is a tracker when it or a parent
+  // domain is on the list; two hosts are the same site when their rough
+  // registrable domains agree.
+  static bool IsTracker(const std::string& host);
+  static std::string SiteOf(const std::string& host);
+  static bool IsThirdParty(const std::string& request_host,
+                           const std::string& top_host);
+
+  // A throttle for `request` when it comes from a Weft page; null otherwise.
+  static std::unique_ptr<blink::URLLoaderThrottle> MaybeCreate(
+      const network::ResourceRequest& request,
+      const base::RepeatingCallback<content::WebContents*()>& wc_getter);
+
+  TrackerThrottle(const TrackerThrottle&) = delete;
+  TrackerThrottle& operator=(const TrackerThrottle&) = delete;
+  ~TrackerThrottle() override;
+
+  // blink::URLLoaderThrottle:
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override;
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override;
+  const char* NameForLoggingWillStartRequest() override;
+
+ private:
+  TrackerThrottle(base::RepeatingCallback<content::WebContents*()> wc_getter);
+
+  // Cancels a request to `url` when the rules say so; true when cancelled.
+  bool MaybeBlock(const GURL& url);
+
+  base::RepeatingCallback<content::WebContents*()> wc_getter_;
+};
+
+// The subresource half: a URLLoaderFactory in front of a Weft page's that
+// completes a blocked request with ERR_BLOCKED_BY_CLIENT and passes every
+// other one through. Modelled on GlicSubresourceProxyingURLLoaderFactory.
+class TrackerFactory : public network::SelfDeletingURLLoaderFactory {
+ public:
+  TrackerFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> loader_receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+      base::WeakPtr<content::WebContents> contents,
+      base::SelfDeletingPassKey pass_key);
+  TrackerFactory(const TrackerFactory&) = delete;
+  TrackerFactory& operator=(const TrackerFactory&) = delete;
+
+  // Puts a TrackerFactory in front of `frame`'s subresource factory when the
+  // frame is in a Weft page.
+  static void MaybeProxyRequest(content::RenderFrameHost* frame,
+                                network::URLLoaderFactoryBuilder& builder);
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override;
+
+ private:
+  ~TrackerFactory() override;
+  void OnTargetFactoryError();
+
+  mojo::Remote<network::mojom::URLLoaderFactory> target_factory_;
+  base::WeakPtr<content::WebContents> contents_;
+};
+
