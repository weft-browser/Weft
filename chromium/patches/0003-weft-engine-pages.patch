+// Watches one page for the shell: navigation state, title, favicon, loading,
+// crashes; and stands in as its delegate for what a page asks of its browser
+// (links that want a new tab, the hovered URL). The decisions are the
+// shell's: this only reports.
+class PageObserver : public content::WebContentsObserver,
+                     public content::WebContentsDelegate {
+ public:
+  PageObserver(WeftUI* ui, const std::string& id, content::WebContents* page)
+      : content::WebContentsObserver(page), ui_(ui), id_(id) {
+    page->SetDelegate(this);
+  }
+  ~PageObserver() override {
+    if (web_contents()) {
+      web_contents()->SetDelegate(nullptr);
+    }
+  }
+
+ private:
+  base::DictValue Event(const char* type) {
+    base::DictValue e;
+    e.Set("type", type);
+    e.Set("id", id_);
+    return e;
+  }
+
+  void Sync() {
+    content::WebContents* page = web_contents();
+    if (!page) {
+      return;
+    }
+    content::NavigationController& nav = page->GetController();
+    base::DictValue e = Event("page");
+    e.Set("url", page->GetVisibleURL().spec());
+    e.Set("title", base::UTF16ToUTF8(page->GetTitle()));
+    e.Set("loading", page->IsLoading());
+    e.Set("canBack", nav.CanGoBack());
+    e.Set("canFwd", nav.CanGoForward());
+    e.Set("favicon", favicon_);
+    base::ListValue history;
+    for (int i = 0; i < nav.GetEntryCount(); ++i) {
+      content::NavigationEntry* entry = nav.GetEntryAtIndex(i);
+      base::DictValue h;
+      h.Set("url", entry->GetURL().spec());
+      h.Set("title", base::UTF16ToUTF8(entry->GetTitleForDisplay()));
+      history.Append(std::move(h));
+    }
+    e.Set("history", std::move(history));
+    e.Set("histPos", nav.GetCurrentEntryIndex());
+    ui_->Emit(std::move(e));
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && handle->HasCommitted()) {
+      if (!handle->IsSameDocument()) {
+        favicon_.clear();
+      }
+      Sync();
+    }
+  }
+  void TitleWasSet(content::NavigationEntry* entry) override { Sync(); }
+  void DidStartLoading() override { Sync(); }
+  void DidStopLoading() override { Sync(); }
+  void NavigationEntriesDeleted() override { Sync(); }
+  void DidUpdateFaviconURL(
+      content::RenderFrameHost* rfh,
+      const std::vector<blink::mojom::FaviconURLPtr>& candidates,
+      blink::mojom::FaviconUpdateReason reason) override {
+    if (!rfh->IsInPrimaryMainFrame()) {
+      return;
+    }
+    favicon_ =
+        candidates.empty() ? std::string() : candidates[0]->icon_url.spec();
+    Sync();
+  }
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    base::DictValue e = Event("crashed");
+    e.Set("status", static_cast<int>(status));
+    ui_->Emit(std::move(e));
+  }
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)> callback)
+      override {
+    if (params.disposition == WindowOpenDisposition::kCurrentTab) {
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    }
+    OpenLink(params.url, params.disposition);
+    return nullptr;
+  }
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override {
+    // window.open(): the shell decides where the link goes; the contents
+    // Chromium made for it are dropped and the URL opened afresh.
+    OpenLink(target_url, disposition);
+    return nullptr;
+  }
+  void UpdateTargetURL(content::WebContents* source,
+                       const GURL& url) override {
+    base::DictValue e = Event("hover");
+    e.Set("url", url.spec());
+    ui_->Emit(std::move(e));
+  }
+
+  void OpenLink(const GURL& url, WindowOpenDisposition disposition) {
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      return;
+    }
+    base::DictValue e = Event("openLink");
+    e.Set("url", url.spec());
+    e.Set("activate",
+          disposition == WindowOpenDisposition::kNewForegroundTab ||
+              disposition == WindowOpenDisposition::kNewWindow ||
+              disposition == WindowOpenDisposition::kNewPopup);
+    ui_->Emit(std::move(e));
+  }
+
+  const raw_ptr<WeftUI> ui_;
+  const std::string id_;
+  std::string favicon_;
+};
+
 }  // namespace
 
