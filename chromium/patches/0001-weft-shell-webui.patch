diff --git a/chrome/browser/ui/webui/weft/weft_ui.cc b/chrome/browser/ui/webui/weft/weft_ui.cc
new file mode 100644
index 0000000000..45491ced43
--- /dev/null
+++ b/chrome/browser/ui/webui/weft/weft_ui.cc
@@ -0,0 +1,112 @@
+// Copyright 2026 Walnut Labs LLC
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/weft/weft_ui.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/values.h"
+#include "chrome/grit/weft_resources.h"
+#include "chrome/grit/weft_resources_map.h"
+#include "components/version_info/version_info.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "content/public/common/url_constants.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+
+namespace weft {
+
+namespace {
+
+// The BrowserState the shell receives until the browser owns the model
+// (plan.md, Phase 2): one workspace with one empty tab, no VPN, no
+// extensions, updates off. Shape: weft-browser-app/src/shared/model.ts.
+constexpr char kStubState[] = R"json({
+  "workspaces": [{
+    "id": "ws-stub", "name": "Workspace 1", "color": "#6aa9ff", "icon": null,
+    "env": {"network": "direct", "region": "Seattle, US", "proxy": "", "locale": "en-US",
+            "tz": "America/Los_Angeles", "fp": "standard", "disposable": false, "ext": {}},
+    "tabs": [{
+      "id": "tab-stub", "url": "", "title": "New tab", "pinned": false, "group": null,
+      "icon": null, "favicon": null, "private": false, "blocked": 0, "loading": false,
+      "canBack": false, "canFwd": false, "history": [], "histPos": 0, "zoom": 1
+    }],
+    "groups": [], "active": 0
+  }],
+  "activeWs": 0, "closed": [], "leader": false, "pendingCloseWs": null, "extensions": [],
+  "vpnRegions": ["Seattle, US", "New York, US", "Zurich, CH", "Frankfurt, DE", "Milan, IT", "Singapore, SG"],
+  "vpnConfigured": [], "vpnStatus": {}, "vpnEngine": false, "vpnDir": "", "allow": {},
+  "renameGroup": null, "uiScale": 1, "dataDir": "",
+  "update": {"phase": "off", "current": "", "version": "", "percent": 0, "detail": ""}
+})json";
+
+// The browser half of WeftApi. `getState` answers through window.__weft.resolve
+// and events go through window.__weft.event (shell/bridge.ts in the fork repo).
+class WeftHandler : public content::WebUIMessageHandler {
+ public:
+  WeftHandler() = default;
+  WeftHandler(const WeftHandler&) = delete;
+  WeftHandler& operator=(const WeftHandler&) = delete;
+  ~WeftHandler() override = default;
+
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getState", base::BindRepeating(&WeftHandler::GetState,
+                                        base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "command", base::BindRepeating(&WeftHandler::Command,
+                                       base::Unretained(this)));
+  }
+
+ private:
+  void GetState(const base::ListValue& args) {
+    AllowJavascript();
+    std::optional<base::Value> state =
+        base::JSONReader::Read(kStubState, base::JSON_PARSE_RFC);
+    CHECK(state && state->is_dict());
+    state->GetDict().SetByDottedPath(
+        "update.current", std::string(version_info::GetVersionNumber()));
+    CallJavascriptFunction("__weft.resolve", args[0], *state);
+  }
+
+  void Command(const base::ListValue& args) {
+    AllowJavascript();
+    VLOG(1) << "weft command: " << args;
+  }
+};
+
+}  // namespace
+
+WeftUIConfig::WeftUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kChromeUIWeftHost) {}
+
+WeftUI::WeftUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  web_ui->AddMessageHandler(std::make_unique<WeftHandler>());
+
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(), kChromeUIWeftHost);
+  webui::SetupWebUIDataSource(source, kWeftResources, IDR_WEFT_INDEX_HTML);
+  // React builds the DOM through the DOM API, not HTML strings; Trusted Types
+  // would only block the bundler's module loader.
+  source->DisableTrustedTypesCSP();
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src 'self' 'unsafe-inline';");
+  // Tab favicons are the sites' own URLs.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src 'self' data: blob: https: http:;");
+}
+
+WeftUI::~WeftUI() = default;
+
+}  // namespace weft
diff --git a/chrome/browser/ui/webui/weft/weft_ui.h b/chrome/browser/ui/webui/weft/weft_ui.h
new file mode 100644
index 0000000000..718792d72d
--- /dev/null
+++ b/chrome/browser/ui/webui/weft/weft_ui.h
@@ -0,0 +1,38 @@
+// Copyright 2026 Walnut Labs LLC
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_WEFT_WEFT_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_WEFT_WEFT_UI_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+
+namespace weft {
+
+inline constexpr char kChromeUIWeftHost[] = "weft";
+
+class WeftUI;
+
+class WeftUIConfig : public content::DefaultWebUIConfig<WeftUI> {
+ public:
+  WeftUIConfig();
+};
+
+// chrome://weft: the Weft shell. The page is the React app from
+// weft-browser-app/src/renderer, bundled by scripts/build-shell.sh and reused
+// unchanged; it talks to this controller through the WeftApi protocol
+// (weft-browser-app/src/shared/ipc.ts) over chrome.send.
+class WeftUI : public content::WebUIController {
+ public:
+  explicit WeftUI(content::WebUI* web_ui);
+
+  WeftUI(const WeftUI&) = delete;
+  WeftUI& operator=(const WeftUI&) = delete;
+
+  ~WeftUI() override;
+};
+
+}  // namespace weft
+
+#endif  // CHROME_BROWSER_UI_WEBUI_WEFT_WEFT_UI_H_
