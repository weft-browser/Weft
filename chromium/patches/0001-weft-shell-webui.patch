new file mode 100644
index 0000000000..f3ec52064a
--- /dev/null
+++ b/chrome/browser/resources/weft/BUILD.gn
@@ -0,0 +1,41 @@
+# Copyright 2026 Walnut Labs LLC
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//chrome/common/features.gni")
+import("//tools/grit/grit_rule.gni")
+import("//ui/webui/resources/tools/generate_grd.gni")
+
+# The Weft shell, prebuilt into dist/ by the fork repo's scripts/build-shell.sh
+# (apply.sh runs it) from weft-browser-app/src/renderer. Fixed file names, so
+# this list is static.
+weft_shell_files = [
+  "index.html",
+  "shell.js",
+  "style.css",
+]
+
+grit("resources") {
+  defines = chrome_grit_defines
+  enable_input_discovery_for_gn_analyze = false
+  source = "$target_gen_dir/resources.grd"
+  inputs = []
+  foreach(f, weft_shell_files) {
+    inputs += [ "dist/$f" ]
+  }
+  deps = [ ":build_grd" ]
+  outputs = [
+    "grit/weft_resources.h",
+    "grit/weft_resources_map.h",
+    "grit/weft_resources_map.cc",
+    "weft_resources.pak",
+  ]
+  output_dir = "$root_gen_dir/chrome"
+}
+
+generate_grd("build_grd") {
+  grd_prefix = "weft"
+  out_grd = "$target_gen_dir/resources.grd"
+  input_files = weft_shell_files
+  input_files_base_dir = rebase_path("dist", "//")
+}
