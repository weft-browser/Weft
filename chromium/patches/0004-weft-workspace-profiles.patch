+// What a workspace's environment means to its profile: the network route as
+// the profile's proxy pref (direct, or fixed servers: a proxy, Tor, a tunnel's
+// SOCKS endpoint; `<local>` bypassed), the locale as Accept-Language, and
+// third-party cookies off, always. Timezone and locale emulation per page are
+// Phase 1 follow-ups (plan.md).
+void WeftUI::ApplyEnvironment(Profile* profile, const base::DictValue& env) {
+  PrefService* prefs = profile->GetPrefs();
+  const std::string* rules = env.FindString("rules");
+  prefs->SetDict(proxy_config::prefs::kProxy,
+                 rules && !rules->empty()
+                     ? ProxyConfigDictionary::CreateFixedServers(*rules, "<local>")
+                     : ProxyConfigDictionary::CreateDirect());
+  if (const std::string* locale = env.FindString("locale");
+      locale && !locale->empty()) {
+    // Language codes only; the network service adds the q-values (and
+    // DCHECKs on a ';'). The selected-languages pref is the source of truth:
+    // LanguagePrefs rewrites Accept-Language from it, so both are set.
+    const std::string lang = locale->substr(0, locale->find('-'));
+    const std::string languages =
+        lang == *locale ? *locale : *locale + "," + lang;
+    prefs->SetString(language::prefs::kSelectedLanguages, languages);
+    prefs->SetString(language::prefs::kAcceptLanguages, languages);
+  }
+  prefs->SetInteger(
+      prefs::kCookieControlsMode,
+      static_cast<int>(content_settings::CookieControlsMode::kBlockThirdParty));
+}
