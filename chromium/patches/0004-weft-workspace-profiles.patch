+void WeftUI::OnWorkspaceProfile(const std::string& ws_id, Profile* profile) {
+  auto it = workspaces_.find(ws_id);
+  if (it == workspaces_.end()) {
+    return;
+  }
+  Workspace& ws = *it->second;
+  ws.loading = false;
+  ws.profile = profile;
+  if (profile && ws.env) {
+    ApplyEnvironment(profile, *ws.env);
