 namespace weft {
 
+namespace {
+
+// Weft's files: a relative name of plain path components under DataDir().
+std::optional<base::FilePath> DataPath(const std::string& name) {
+  if (name.empty() || name.front() == '/') {
+    return std::nullopt;
+  }
+  base::FilePath path = WeftUI::DataDir();
+  for (const base::FilePath::StringType& part :
+       base::FilePath(name).GetComponents()) {
+    if (part.empty() || part == "." || part == ".." ||
+        part.find('/') != std::string::npos) {
+      return std::nullopt;
+    }
+    path = path.Append(part);
+  }
+  return path;
+}
+
+std::optional<std::string> ReadFileTask(base::FilePath path) {
+  std::string text;
+  if (!base::ReadFileToString(path, &text)) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+bool WriteFileTask(base::FilePath path, std::string text) {
+  return base::CreateDirectory(path.DirName()) &&
+         base::ImportantFileWriter::WriteFileAtomically(path, text);
+}
+
+std::vector<std::string> ListDirTask(base::FilePath path) {
+  std::vector<std::string> names;
+  base::FileEnumerator it(path, false, base::FileEnumerator::FILES);
+  for (base::FilePath f = it.Next(); !f.empty(); f = it.Next()) {
+    names.push_back(f.BaseName().value());
+  }
+  return names;
+}
+
