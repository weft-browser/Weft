+void WeftUI::ClearSite(const std::string& ws_id,
+                       const std::string& host,
+                       base::OnceClosure done) {
+  auto it = workspaces_.find(ws_id);
+  Profile* profile = it == workspaces_.end() ? nullptr : it->second->profile.get();
+  if (!profile) {
+    std::move(done).Run();
+    return;
+  }
+  // By registrable domain: what cookie deletion matches on (an IP or an
+  // internal host is its own), and storage and cache follow it. The shell's
+  // host may carry a port (hostOf() in model.ts): dropped here.
+  const std::string hostname(GURL("http://" + host).host());
+  auto filter = content::BrowsingDataFilterBuilder::Create(
+      content::BrowsingDataFilterBuilder::Mode::kDelete);
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          hostname,
+          net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  filter->AddRegisterableDomain(domain.empty() ? hostname : domain);
+  // The remover reports to a registered observer; this one lives for the task.
+  class Done : public content::BrowsingDataRemover::Observer {
+   public:
+    Done(content::BrowsingDataRemover* remover, base::OnceClosure done)
+        : remover_(remover), done_(std::move(done)) {
+      remover_->AddObserver(this);
+    }
+    void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+      LOG_IF(ERROR, failed_data_types)
+          << "weft: clearing site data failed for types " << failed_data_types;
+      remover_->RemoveObserver(this);
+      std::move(done_).Run();
+      delete this;
+    }
+
+   private:
+    const raw_ptr<content::BrowsingDataRemover> remover_;
+    base::OnceClosure done_;
+  };
+  content::BrowsingDataRemover* remover = profile->GetBrowsingDataRemover();
+  remover->RemoveWithFilterAndReply(
+      base::Time(), base::Time::Max(),
+      content::BrowsingDataRemover::DATA_TYPE_COOKIES |
+          content::BrowsingDataRemover::DATA_TYPE_DOM_STORAGE |
+          content::BrowsingDataRemover::DATA_TYPE_CACHE,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB |
+          content::BrowsingDataRemover::ORIGIN_TYPE_PROTECTED_WEB,
+      std::move(filter), new Done(remover, std::move(done)));
+}
