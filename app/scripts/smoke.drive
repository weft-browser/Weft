# Walk the shell the way the design shows it. Run: node scripts/drive.mjs scripts/smoke.drive
launch
ss 01-fresh
# a page in the first tab
click #addr
type example.com
press Enter
wait 2500
ss 02-page
page-ss 02-page-view
# the rail flies out over the page; the live page slides right instead of covering it
hover .rail
wait 400
ss 03-rail-open
hover .toolbar
leader v
wait 400
ss 03b-env-panel
press Escape
# private tab via the leader key, then a page in it
leader T
wait 400
ss 04-private-tab
type example.org
press Enter
wait 2500
ss 04b-private-page
# the all-tabs panel
leader a
wait 400
ss 05-all-tabs
press Escape
# right-click menus: workspace, new-tab button, env chip, shield, back button
rclick .rail-btn.ws
ss 06-ws-menu
press Escape
hover .toolbar
rclick .strip .icon-btn
ss 07-newtab-menu
press Escape
rclick .envchip
ss 08-route-menu
press Escape
rclick .shield
ss 09-shield-menu
press Escape
leader h
wait 300
# Back is disabled until the tab has somewhere to go back to
click #addr
type example.org
press Enter
wait 2500
rclick .toolbar .icon-btn
ss 10-history-menu
press Escape
state
quit
