{
  "name": "weft",
  "version": "0.1.2",
  "private": true,
  "description": "Weft: a keyboard-first browser organised as workspaces \u00d7 tabs, each workspace its own environment.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-vite build && electron-builder --mac dir --arm64 -c.electronDist=node_modules/electron/dist --publish never",
    "package:release": "electron-vite build && electron-builder --mac --publish never",
    "postinstall": "node scripts/brand-dev-electron.mjs"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.59.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "productName": "Weft",
  "build": {
    "appId": "com.walnutlabs.weft",
    "productName": "Weft",
    "copyright": "Walnut Labs LLC",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleName": "Weft",
        "CFBundleDisplayName": "Weft",
        "NSHumanReadableCopyright": "Walnut Labs LLC"
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "14.0"
    },
    "dmg": {
      "sign": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.weftbrowser.com/"
      }
    ]
  }
}
